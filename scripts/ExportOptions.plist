<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- App Store distribution, but only export the IPA to disk. The actual
       upload is done separately by `asc builds upload`, so destination is
       "export" (not "upload"). -->
  <key>method</key>
  <string>app-store-connect</string>
  <key>destination</key>
  <string>export</string>

  <key>teamID</key>
  <string>ZHKJ4NHK6F</string>

  <!-- Manual signing with explicit App Store profiles. Automatic signing here
       makes xcodebuild attempt cloud signing at export, which the CI App Store
       Connect API key is not authorised for ("Cloud signing permission error").
       Instead beta_ci.sh installs these profiles (created once via `asc`, bound
       to the Apple Distribution certs) into the runner's provisioning-profile
       dir, and we reference them by name here. The matching Apple Distribution
       cert lives in the login keychain (locally) or the imported .p12 (CI).
       See scripts/testflight_certificate_renewal.md. -->
  <key>signingStyle</key>
  <string>manual</string>
  <key>signingCertificate</key>
  <string>Apple Distribution</string>
  <key>provisioningProfiles</key>
  <dict>
    <key>com.paulgessinger.swift-paperless</key>
    <string>swift-paperless AppStore CI</string>
    <key>com.paulgessinger.swift-paperless.ShareExtension</key>
    <string>swift-paperless ShareExtension AppStore CI</string>
  </dict>

  <!-- The build number is the source of truth in Version.xcconfig; never let
       Xcode rewrite it. -->
  <key>manageAppVersionAndBuildNumber</key>
  <false/>

  <key>uploadSymbols</key>
  <true/>
  <key>stripSwiftSymbols</key>
  <true/>
</dict>
</plist>
