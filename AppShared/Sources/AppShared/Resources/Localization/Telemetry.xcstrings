      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen identifikator: ingen konto, enheds-id eller annonce-id, intet, der er det samme fra dag til dag"
          }
        },
        "de" : {
