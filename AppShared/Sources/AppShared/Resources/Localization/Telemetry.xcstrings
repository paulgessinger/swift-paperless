    "summary" : {
      "comment" : "Short description of usage sharing, under its title in Settings and on the onboarding card.",
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hjælp med at bestemme, hvad der skal bygges næste gang. Intet identificerer dig eller dine dokumenter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
