{
  "sourceLanguage" : "en",
  "strings" : {
    "explanationIntro" : {
      "comment" : "First paragraph of the usage sharing explanation, written by the developer in the first person.",
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swift Paperless udvikles hovedsageligt af én udvikler, mig, i min fritid. Brugsdata hjælper mig med at bruge den tid, hvor den forbedrer appen mest, for eksempel ved at vise, hvilke versioner af Paperless-ngx og iOS der stadig er i brug, og hvilke funktioner folk faktisk bruger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swift Paperless wird größtenteils von einem einzelnen Entwickler, mir, in meiner Freizeit entwickelt. Nutzungsdaten helfen mir, diese Zeit dort einzusetzen, wo sie die App am meisten verbessert, zum Beispiel indem sie zeigen, welche Paperless-ngx- und iOS-Versionen noch verwendet werden und welche Funktionen tatsächlich genutzt werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swift Paperless is largely developed by a single developer, me, in my spare time. Usage data helps me spend that time where it improves the app the most, for example by showing which Paperless-ngx and iOS versions are still in use, and which features people actually use."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swift Paperless est en grande partie développé par une seule personne, moi, sur mon temps libre. Les données d'utilisation m'aident à consacrer ce temps là où il améliore le plus l'app, par exemple en montrant quelles versions de Paperless-ngx et d'iOS sont encore utilisées, et quelles fonctionnalités sont réellement utilisées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swift Paperless è sviluppato in gran parte da un solo sviluppatore, io, nel mio tempo libero. I dati di utilizzo mi aiutano a dedicare quel tempo dove migliora di più l'app, ad esempio mostrando quali versioni di Paperless-ngx e di iOS sono ancora in uso e quali funzioni vengono effettivamente usate."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swift Paperless wordt grotendeels door één ontwikkelaar gemaakt, mij, in mijn vrije tijd. Gebruiksgegevens helpen me die tijd te besteden waar het de app het meest verbetert, bijvoorbeeld door te laten zien welke versies van Paperless-ngx en iOS nog in gebruik zijn en welke functies mensen echt gebruiken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swift Paperless jest rozwijany głównie przez jednego programistę, mnie, w wolnym czasie. Dane o użytkowaniu pomagają mi poświęcać ten czas tam, gdzie najbardziej ulepsza on aplikację, na przykład pokazując, które wersje Paperless-ngx i iOS są nadal używane oraz z których funkcji ludzie faktycznie korzystają."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swift Paperless büyük ölçüde tek bir geliştirici, yani ben tarafından boş zamanlarımda geliştiriliyor. Kullanım verileri bu zamanı uygulamayı en çok iyileştireceği yere ayırmama yardımcı oluyor; örneğin hangi Paperless-ngx ve iOS sürümlerinin hâlâ kullanıldığını ve insanların gerçekte hangi özellikleri kullandığını göstererek."
          }
        }
      }
    },
    "explanationReports" : {
      "comment" : "Second paragraph of the explanation.",
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du slår dette til, og kun da, sender appen to separate rapporter, hver højst én gang om dagen. Brugsserveren kombinerer eller forbinder dem ikke."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du das einschaltest, und nur dann, sendet die App zwei getrennte Berichte, jeden höchstens einmal am Tag. Der Nutzungsserver führt sie nicht zusammen und verknüpft sie nicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you turn this on, and only then, the app sends two separate reports, each at most once a day. The usage server does not combine or link them."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque vous activez cette option, et seulement dans ce cas, l'app envoie deux rapports distincts, chacun au plus une fois par jour. Le serveur d'utilisation ne les combine ni ne les relie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando attivi questa opzione, e solo allora, l'app invia due rapporti separati, ciascuno al massimo una volta al giorno. Il server di utilizzo non li combina né li collega."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als je dit inschakelt, en alleen dan, verstuurt de app twee afzonderlijke rapporten, elk hooguit één keer per dag. De gebruiksserver combineert of koppelt ze niet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy to włączysz, i tylko wtedy, aplikacja wysyła dwa osobne raporty, każdy najwyżej raz dziennie. Serwer danych o użytkowaniu ich nie łączy ani nie powiązuje."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bunu açtığınızda, ve yalnızca o zaman, uygulama her biri günde en fazla bir kez olmak üzere iki ayrı rapor gönderir. Kullanım sunucusu bunları birleştirmez veya ilişkilendirmez."
          }
        }
      }
    },
    "explanationServer" : {
      "comment" : "Paragraph about what the usage server keeps.",
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brugsserveren læser aldrig IP-adresser og logger dem ikke. Den deler hver rapport op med det samme og tæller kun hver værdi for sig, så den gemmer ikke, hvilke værdier der hørte sammen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Nutzungsserver liest IP-Adressen nie aus und protokolliert sie nicht. Er zerlegt jeden Bericht sofort und zählt jeden Wert nur für sich, sodass er nicht speichert, welche Werte zusammen kamen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The usage server never reads IP addresses and doesn't log them. It splits each report up right away and only counts each value on its own, so it doesn't store which values came together."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur d'utilisation ne lit jamais les adresses IP et ne les enregistre pas. Il décompose chaque rapport immédiatement et ne compte chaque valeur que séparément, de sorte qu'il ne conserve pas quelles valeurs allaient ensemble."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il server di utilizzo non legge mai gli indirizzi IP e non li registra. Scompone subito ogni rapporto e conta ogni valore singolarmente, quindi non memorizza quali valori erano insieme."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De gebruiksserver leest IP-adressen nooit uit en logt ze niet. Hij splitst elk rapport meteen op en telt elke waarde afzonderlijk, zodat hij niet opslaat welke waarden bij elkaar hoorden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serwer danych o użytkowaniu nigdy nie odczytuje adresów IP i ich nie zapisuje. Od razu rozbija każdy raport i zlicza każdą wartość osobno, więc nie przechowuje informacji, które wartości wystąpiły razem."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kullanım sunucusu IP adreslerini asla okumaz ve kaydetmez. Her raporu hemen parçalarına ayırır ve her değeri yalnızca kendi başına sayar; böylece hangi değerlerin birlikte geldiğini saklamaz."
          }
        }
      }
    },
    "explanationTurnOff" : {
      "comment" : "Last paragraph of the explanation.",
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du slår dette fra, sendes der ikke mere, og registreringerne på denne enhed slettes med det samme."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du das ausschaltest, wird nichts mehr gesendet, und die Aufzeichnungen auf diesem Gerät werden sofort gelöscht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you turn this off, nothing more is sent, and the bookkeeping on this device is deleted immediately."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si vous désactivez cette option, plus rien n'est envoyé, et les données de suivi sur cet appareil sont supprimées immédiatement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se disattivi questa opzione, non viene inviato più nulla e i dati registrati su questo dispositivo vengono eliminati immediatamente."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als je dit uitschakelt, wordt er niets meer verstuurd en wordt de administratie op dit apparaat direct verwijderd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli to wyłączysz, nic więcej nie zostanie wysłane, a zapisy na tym urządzeniu zostaną natychmiast usunięte."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bunu kapatırsanız artık hiçbir şey gönderilmez ve bu cihazdaki kayıtlar hemen silinir."
          }
        }
      }
    },
