    "resetAppVersionDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appen foretager en vis bogføring baseret på app-versionen. Dette nulstiller app-versionen og får appen til at fungere, som om det var en ren installation."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App führt bestimmte Buchhaltungsaufgaben auf der Grundlage der App-Version aus. Hier kann die App-Version zurückgesetzt werden, so dass die App so funktioniert, als wäre sie neu installiert worden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The app does certain bookkeeping based on the app version. This resets the app version, making the app perform as if it was a clean install."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'application effectue certaines opérations de compatibilité en fonction de la version de l'application. Cette opération réinitialise la version de l'application, de sorte que l'application fonctionne comme s'il s'agissait d'une installation propre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'applicazione esegue alcune operazioni contabili in base alla versione dell'applicazione. Ripristinando la versione dell'app, questa si comporterà come se fosse un'installazione pulita."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De app voert een bepaalde boekhouding op basis van de app-versie. Hierdoor wordt de app-versie gereset, waardoor de app presteert alsof het een schone installatie is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacja wykonuje pewne czynności w zależności od zapisanej wersji aplikacji. Ta funkcja resetuje zapisaną wersję, dzięki czemu aplikacja działa tak, jakby była świeżo zainstalowania."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulama, sürümüne bağlı olarak belirli kayıtlar tutar. Bu, uygulama sürümünü sıfırlar ve uygulamanın temiz bir yükleme gibi çalışmasını sağlar."
          }
        }
      }
    },
