    "tipJarDescription" : {
      "comment" : "Tip jar description text",
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Støt udviklingen med et **engangs-tip**! Tips er **valgfrie** og låser ikke op for ekstra funktioner."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unterstütze die Entwicklung mit einer **einmaligen Spende**! Spenden sind **optional** und schalten keine zusätzlichen Funktionen frei."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Support development with a **one-time tip**! Tips are **optional** and don’t unlock extra features."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soutenez le développement avec une **contribution unique** !\nLes contributions sont **facultatives** et n’activent aucune fonctionnalité supplémentaire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sostenete lo sviluppo con un **singolo suggerimento**! Le mance sono **opzionali** e non sbloccano funzioni extra."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steun de ontwikkeling met een **eenmalige tip**! Tips zijn **optioneel** en ontgrendelen geen extra functies."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wesprzyj rozwój za pomocą **jednorazowego napiwku**! Napiwki są **opcjonalne** i nie odblokowują dodatkowych funkcji."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir **tek seferlik bahşiş** ile geliştirmeyi destekleyin! Bahşişler **isteğe bağlıdır** ve ekstra özelliklerin kilidini açmaz."
          }
        }
      }
    },
