    "offlineBrowsingDowngradeConfirm" : {
      "comment" : "Destructive confirm button that turns off whole-library offline browsing and deletes the downloaded documents",
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
