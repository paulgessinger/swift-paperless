    "uploadDocumentIntentLoadOptionsError" : {
      "comment" : "Shown in the Shortcuts app when the tag/document type/correspondent list cannot be loaded. %@ is the underlying error.",
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunne ikke indlæse valgmuligheder fra Paperless: %@"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optionen konnten nicht von Paperless geladen werden: %@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Could not load options from Paperless: %@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de charger les options depuis Paperless : %@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile caricare le opzioni da Paperless: %@"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan opties niet laden uit Paperless: %@"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie można wczytać opcji z Paperless: %@"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seçenekler Paperless'tan yüklenemedi: %@"
          }
        }
      }
    },
    "uploadDocumentIntentMissingElementError" : {
      "comment" : "Shown when a tag, document type or correspondent saved in a shortcut no longer exists. %@ is the kind of item, e.g. \"Tag\".",
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det valgte element (%@) findes ikke længere i Paperless. Rediger genvejen, og vælg det igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das ausgewählte Element (%@) existiert nicht mehr in Paperless. Bearbeite den Kurzbefehl und wähle es erneut aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The selected %@ no longer exists in Paperless. Edit the shortcut and pick it again."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'élément sélectionné (%@) n'existe plus dans Paperless. Modifiez le raccourci et sélectionnez-le à nouveau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'elemento selezionato (%@) non esiste più in Paperless. Modifica il comando rapido e selezionalo di nuovo."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het geselecteerde item (%@) bestaat niet meer in Paperless. Bewerk de opdracht en kies het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybrany element (%@) nie istnieje już w Paperless. Edytuj skrót i wybierz go ponownie."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seçilen öğe (%@) artık Paperless'ta mevcut değil. Kestirmeyi düzenleyip öğeyi yeniden seçin."
          }
        }
      }
    },
    "uploadDocumentIntentNoConnectionError" : {
      "comment" : "Shown when a shortcut runs but no Paperless server has been set up in the app.",
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der er ikke konfigureret nogen Paperless-server. Åbn Paperless, og log ind først."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es ist kein Paperless-Server eingerichtet. Öffne zuerst Paperless und melde dich an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No Paperless server is configured. Open Paperless and sign in first."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun serveur Paperless n'est configuré. Ouvrez d'abord Paperless et connectez-vous."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessun server Paperless configurato. Apri prima Paperless ed effettua l'accesso."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er is geen Paperless-server ingesteld. Open eerst Paperless en log in."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie skonfigurowano serwera Paperless. Najpierw otwórz Paperless i zaloguj się."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yapılandırılmış bir Paperless sunucusu yok. Önce Paperless'ı açıp oturum açın."
          }
        }
      }
    },
